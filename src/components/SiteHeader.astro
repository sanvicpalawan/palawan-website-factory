---
const { path = '/', flavor = 'cafe' } = Astro.props;

const config = {
  cafe: {
    name: 'Daloy',
    sub: 'Café · Table · Palawan',
    cta: 'Reserve a table',
    links: [
      { href: '/#menu', label: 'Menu' },
      { href: '/#featured', label: 'Signature' },
      { href: '/#story', label: 'Story' },
      { href: '/#gallery', label: 'Gallery' },
      { href: '/#nfc', label: 'NFC' },
    ],
  },
  resort: {
    name: 'Amanpulo',
    sub: 'Eco-Resort · Palawan',
    cta: 'Reserve a stay',
    links: [
      { href: '/resort/#island', label: 'Island' },
      { href: '/resort/#stay', label: 'Stay' },
      { href: '/resort/#explore', label: 'Explore' },
      { href: '/resort/#wellness', label: 'Wellness' },
      { href: '/resort/#nfc', label: 'NFC' },
    ],
  },
  tours: {
    name: 'Daluyon',
    sub: 'Island Hopping · El Nido',
    cta: 'Book a seat',
    links: [
      { href: '/tours/#packages', label: 'Tours' },
      { href: '/tours/#day', label: 'The Day' },
      { href: '/tours/#crew', label: 'Crew' },
      { href: '/tours/#faq', label: 'FAQ' },
      { href: '/tours/#nfc', label: 'NFC' },
    ],
  },
};

const c = config[flavor];

const starters = [
  { href: '/', label: 'Café' },
  { href: '/resort/', label: 'Resort' },
  { href: '/tours/', label: 'Tours' },
];
---

<header class="site-header" id="siteHeader">
  <div class="wrap header-inner">
    <a class="brand" href={flavor === 'cafe' ? '/' : `/${flavor}/`} aria-label={`${c.name} — home`}>
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 32 32" width="24" height="24" fill="none">
          <path d="M16 3c3.4 5.6 7 9.2 7 13.4a7 7 0 0 1-14 0C9 12.2 12.6 8.6 16 3z" stroke="currentColor" stroke-width="1.3" />
          <path d="M3 26c4-2.2 6 2.2 10 0s6 2.2 10 0 5 1.2 6 0" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
        </svg>
      </span>
      <span class="brand-text">
        <span class="brand-name">{c.name}</span>
        <span class="brand-sub">{c.sub}</span>
      </span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      {c.links.map((l) => (
        <a href={l.href}>{l.label}</a>
      ))}
    </nav>

    <div class="header-actions">
      <nav class="starters-nav" aria-label="Starters">
        {starters.map((s) => (
          <a href={s.href} aria-current={path === s.href ? 'page' : undefined}>{s.label}</a>
        ))}
      </nav>
      <a class="btn btn-ghost btn-sm" href="/admin">Client area</a>
      <a class="btn btn-clay btn-sm" href={flavor === 'cafe' ? '/#reserve' : `/${flavor}/#reserve`}>{c.cta}</a>
      <button class="nav-toggle" id="navToggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobileNav">
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<div class="mobile-nav" id="mobileNav" aria-hidden="true">
  <nav aria-label="Mobile" class="wrap">
    {c.links.map((l) => <a href={l.href}>{l.label}</a>)}
    <a href={flavor === 'cafe' ? '/#reserve' : `/${flavor}/#reserve`} class="btn btn-clay">{c.cta}</a>
    <a href="/admin" class="btn btn-ghost">Client area</a>
    <div class="mobile-contact">
      {starters.map((s) => <a href={s.href}>{s.label}</a>)}
    </div>
  </nav>
</div>
