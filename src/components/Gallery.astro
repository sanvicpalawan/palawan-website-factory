---
import { gallery } from '../lib/data';
import { asset } from '../lib/asset';
---

<section class="section gallery" id="gallery">
  <div class="wrap">
    <header class="section-head reveal">
      <p class="eyebrow">04 · The Room</p>
      <h2 class="display">Morning light to <em>last orders.</em></h2>
    </header>
  </div>

  <div class="gallery-strip" id="galleryStrip">
    {gallery.map((g) => (
      <figure class="gallery-item reveal">
        <img src={asset(g.img)} alt={g.alt} loading="lazy" />
      </figure>
    ))}
  </div>
  <p class="wrap gallery-hint" aria-hidden="true"><span class="hint-rule"></span> Drag or scroll sideways</p>
</section>
